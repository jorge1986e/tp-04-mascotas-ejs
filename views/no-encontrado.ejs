<section
    class="max-w-[45rem] p-[clamp(1.5rem,_5vw,_4rem)] bg-gray-300/40 border border-[#d8d0c5] rounded-[1.25rem] bg-[#fffdf9] shadow-[0_1rem_2.5rem_rgb(75_63_48_/_8%)] mx-auto">


    <p class="mb-2 text-[#a87608] text-5xl font-extrabold tracking-[0.12em] uppercase text-center ">ERROR 404</p>
    <h1 class="mt-0 text-[clamp(2rem,6vw,3.75rem)] leading-[1.05] font-bold text-center">
        <%= titulo %>
    </h1>
    <p class="text-center mb-7">
        <%= mensaje %>
    </p>


    <div class="items-center justify-center gap-4 mt-7 w-full max-w-7xl">
        <img src="/img/404.webp" alt="Descripción 1" width="500" height="300">

        <div class="flex justify-center">
            <a class="inline-block px-[clamp(1rem,2.5vw,1.5rem)] py-[clamp(0.5rem,1.5vw,0.75rem)] mt-6 bg-[#eda200] text-black text-[clamp(0.875rem,2vw,1rem)] font-bold rounded-xl hover:bg-[#a87608] hover:text-white transition-colors"
                href="/mascotas">Volver al catalogo</a>
        </div>


</section>