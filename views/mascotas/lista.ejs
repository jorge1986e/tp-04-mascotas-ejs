<header class="w-full max-w-[45rem] flex items-end justify-between gap-4 mb-8">
                             

    <div>

        <p class="mb-2 text-[#a87608] text-xs font-extrabold tracking-[0.12em] uppercase">CATALOGO</p>

        <h1 class="mt-0 text-[clamp(2rem,6vw,3.75rem)] leading-[1.05] font-bold">
            <%= titulo %>
        </h1>

    </div>

</header>

<% if (mascotas.length===0) { %>
    <p>No hay mascotas para mostrar</p>

    <% } else { %>

        <section class="grid grid-cols-[repeat(auto-fit,minmax(14rem,2fr))] gap-4 place-items-center"
            aria-label="Mascotas disponibles">
            <% mascotas.forEach((mascota)=> { %>

                <article class="bg-gray-300/40 p-2 rounded-xl w-60 h-87">

                    <img class="rounded-t-xl mx-auto" src="<%= mascota.imagen %>" alt="foto: <%= mascota.nombre %>">

                    <p class="mb-1 text-[#7d740a] text-xs font-extrabold tracking-[0.12em] uppercase">
                        <%= mascota.especie %>
                    </p>

                    <h2 class="mt-0 leading-[1.2] font-bold text-xl">
                        <%= mascota.nombre %>
                    </h2>

                    <p>
                        <%= mascota.estado %>
                    </p>

                    <a class="font-bold text-[#946904] underline" href="/mascotas/<%= mascota.id %>">Detalle</a>

                </article>
                <% }) %>
        </section>
        <% } %>