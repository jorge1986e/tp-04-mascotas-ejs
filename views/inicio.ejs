<section
    class="w-[min(70rem,calc(100%-2rem))] max-w-[45rem]  mx-auto  p-[clamp(1.5rem,5vw,4rem)] bg-gray-300/40 rounded-[1.25rem]  shadow-xl  flex flex-col items-center">

    <h1 class="mt-0 text-[clamp(2rem,10vw,5rem)] leading-[1.05] font-bold">
        <%= titulo %>
    </h1>

    <p class="mb-2 text-[#a87608] text-[clamp(0.7rem,0.9vw,0.875rem)] font-bold tracking-[0.12em] uppercase">Adopta,
        colabora y sé parte de
        Mascoteros</p>

    <p class="mt-5 text-[clamp(0.95rem,2vw,1.125rem)] leading-relaxed text-center">En Mascoteros rescatamos, cuidamos y
        transformamos la vida de animales en situación de calle. Conoce a tu próximo
        mejor amigo o súmate a nuestra red de apoyo para cambiar sus historias.</p>

    <a class="inline-block px-[clamp(1rem,2.5vw,1.5rem)] py-[clamp(0.5rem,1.5vw,0.75rem)] mt-6 bg-[#eda200] text-black text-[clamp(0.875rem,2vw,1rem)] font-bold rounded-xl hover:bg-[#a87608] hover:text-white transition-colors"
        href="/mascotas">Ver Mascotas</a>

</section class="flex flex-col items-center justify-center min-h-screen gap-6 p-4">

<section>
    <div class="flex flex-col md:flex-row items-center justify-center gap-4 mt-7 w-full max-w-7xl">
        <img src="/img/1.webp" alt="Descripción 1" width="400" height="200">
        <img src="/img/2.webp" alt="Descripción 2" width="400" height="200">
    </div>

    <div class="flex flex-col md:flex-row items-center justify-center gap-4 mt-7 w-full max-w-7xl">
        <img src="/img/3.webp" alt="Descripción 1" width="400" height="200" class="object-cover w-full md:w-auto">
        <img src="/img/4.webp" alt="Descripción 2" width="400" height="200" class="object-cover w-full md:w-auto">
        </div>
</section>